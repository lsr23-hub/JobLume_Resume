# 依赖与构建产物
node_modules/
dist/
.output/
build/
coverage/
*.tsbuildinfo
src/routeTree.gen.ts

# 环境与密钥
.env
.env*.local
*.pem
*.key

# 系统与编辑器
.DS_Store
.idea/
.history/
.agent/
.tanstack/

# 包管理器调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 演示产物（简历截图），不入库
/demo/

# 评测产物（每次跑都重新生成）
eval-results/

# 用户存档（默认存档目录 saves/<userId>/）——
# 这是**用户数据**，含姓名、联系方式、经历，绝不能入库。
#
# ⚠️ 开头的 `/` 不能省：不带斜杠的 `saves/` 会匹配**任意深度**下叫 saves 的目录，
# 把 `src/lib/saves/`（存档功能的源码）一并忽略掉。实测踩过 —— 那批源码因此
# 从没进过 git，而本地构建照常通过，直到有人 clone 才发现构建不过。
/saves/

# 字体的**源文件**（原始 TTF/OTF，共 ~113MB）。应用加载的是 public/fonts 下的
# 子集化产物，这些原始文件只在重新生成子集时用得上，不进库。
# 重新生成见 `pnpm subset:fonts` 与 public/fonts/README.md。
/font-sources/
